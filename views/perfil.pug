extends layout

block estilos
  style.
    .galeria-contenedor { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; align-items: stretch; }
    .tarjeta-foto { display: flex; flex-direction: column; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 8px rgba(0,0,0,0.05); transition: transform 0.2s ease, box-shadow 0.2s ease; height: 100%; }
    .tarjeta-foto:hover { transform: translateY(-5px); box-shadow: 0 8px 16px rgba(0,0,0,0.1); }
    .contenedor-imagen { height: 220px; width: 100%; border-bottom: 1px solid #f4eae6; }
    .contenedor-imagen img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .info-foto { padding: 15px; display: flex; flex-direction: column; flex-grow: 1; }
    .etiqueta-pill { display: inline-block; background-color: #8a5a44; color: white; padding: 4px 10px; border-radius: 15px; font-size: 0.8em; margin-right: 5px; margin-top: 8px; text-decoration: none; }
    .enlace-tarjeta { text-decoration: none; color: inherit; display: flex; flex-direction: column; flex-grow: 1; }

block contenido
  div(style="max-width: 1000px; margin: 40px auto; padding: 20px;")
    h2(style="color: #8a5a44; text-align: center; margin-bottom: 30px;") Mi Perfil

    div(style="display: flex; justify-content: center; gap: 30px; margin: 20px 0; font-size: 1.1em; color: #555; margin-bottom: 25px;")
      div
        strong #{cantSeguidores} 
        | Seguidores
      div
        strong #{cantSeguidos} 
        | Seguidos

    div(style="text-align: center; margin-bottom: 30px;")
      a.btn-oscuro(href="/mi-perfil/denuncias" style="background-color: #cc0000; border-color: #cc0000; text-decoration: none;") Ver Comentarios Denunciados
    
    if fotos && fotos.length > 0
      div.galeria-contenedor
        each foto in fotos
          div.tarjeta-foto
            
            a.enlace-tarjeta(href=`/foto/${foto.id}`)
              div.contenedor-imagen
                if foto.imagenes && foto.imagenes.length > 0
                  img(src=foto.imagenes[0].url_imagen alt=foto.titulo)
                else
                  div(style="width: 100%; height: 100%; background: #eee; display: flex; align-items: center; justify-content: center; color: #999;") Sin imagen
              
              div.info-foto
                h4(style="margin: 0 0 5px 0; color: #333;")= foto.titulo
                
                if foto.descripcion
                  p(style="margin: 8px 0 0 0; color: #666; font-size: 0.9em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;")= foto.descripcion
                else
                  p(style="margin: 8px 0 0 0; color: #aaa; font-size: 0.9em; font-style: italic;") Sin descripcion
                
                if foto.etiquetas
                  div(style="margin-top: auto; padding-top: 10px;")
                    each etiqueta in foto.etiquetas
                      span.etiqueta-pill= etiqueta.nombre
                  
            div(style="display: flex; justify-content: space-between; align-items: center; padding: 10px 15px; background: #faf4ed; border-top: 1px solid #eee;")
              a(href=`/publicacion/${foto.id}/editar` style="color: #f39c12; text-decoration: none; font-weight: bold;") Editar
              
              form(action=`/publicacion/${foto.id}/eliminar` method="POST" onsubmit="return confirm('Estas seguro de que quieres eliminar esta foto para siempre?');" style="margin: 0;")
                button(type="submit" style="background: none; border: none; color: #cc0000; font-weight: bold; cursor: pointer;") Eliminar
    else
      div(style="text-align: center; padding: 40px; background: #fff; border-radius: 8px;")
        h3(style="color: #666;") Aun no hay fotos subidas
        a.btn-oscuro(href="/nuevaFoto" style="margin-top: 20px; display: inline-block;") Subi tu primer foto!