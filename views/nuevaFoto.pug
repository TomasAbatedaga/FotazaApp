extends layout

block metadata
  title Fotaza 2 - Subir Nueva Foto

block contenido
  div(style="max-width: 600px; margin: 40px auto; background: #fff; padding: 20px; border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.05);")
    h1(style="text-align: center; color: #8a5a44;") Compartir nueva foto
    
    form(action="/nuevaFoto" method="POST" style="display: flex; flex-direction: column; gap: 15px;")
      
      div
        label(for="foto_local") Sube tu foto (Solo JPG o PNG):
        input(type="file" id="fotos_locales" accept="image/jpeg, image/png" multiple required)
        div#contenedor-preview(style="display: none; margin-top: 15px; background: #faf4ed; padding: 15px; border-radius: 8px;")
          p(style="color: #8a5a44; font-size: 0.9em; margin: 0 0 10px 0; font-weight: bold;") Vista previa de tus imagenes seleccionadas:
          div#galeria-preview(style="display: flex; gap: 10px; flex-wrap: wrap; justify-content: center;")
        input(type="hidden" name="url_imagen" id="url_imagen_base64")
      
      div
        label(for="titulo" style="font-weight: bold;") Titulo:
        input(type="text" name="titulo" id="titulo" minlength="3" maxlength="150" required style="width: 100%; padding: 10px; margin-top: 5px; border: 1px solid #ccc; border-radius: 5px;")

      div
        label(for="descripcion" style="font-weight: bold;") Descripcion:
        textarea(name="descripcion" id="descripcion" rows="4" style="width: 100%; padding: 10px; margin-top: 5px; border: 1px solid #ccc; border-radius: 5px;")
      
      div 
        label
          input(type="checkbox" name="tiene_copyright" id="tiene_copyright" value="si")
        | Estas imagenes tienen Copyright (Aplicar marca de agua)

      div
        label(style="font-weight: bold;") Etiquetas (Selecciona al menos una):
        div(style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px;")
          if etiquetas
            each etiqueta in etiquetas
              label(style="background: #faf4ed; padding: 5px 10px; border-radius: 15px; cursor: pointer; border: 1px solid #8a5a44;")
                input(type="checkbox" name="etiquetas[]" value=etiqueta.id style="margin-right: 5px;")
                | #{etiqueta.nombre}
    
      div(style="margin-top: 15px;")
        label(for="nuevas_etiquetas" style="font-weight: bold;") Ingrese nuevas etiquetas si desea (separadas por coma):
        input(type="text" name="nuevas_etiquetas" id="nuevas_etiquetas" placeholder="Ej: Viajes, Mascota, Verano" style="width: 100%; padding: 10px; margin-top: 5px; border: 1px solid #ccc; border-radius: 5px;")

      div#contenedor_base64

      button.btn-oscuro(type="submit" style="margin-top: 10px; padding: 12px; font-size: 16px; border: none; border-radius: 5px; cursor: pointer;") Publicar Foto

block scripts
      script.
        const inputFotos = document.getElementById('fotos_locales');
        const contenedorBase64 = document.getElementById('contenedor_base64');
        const contenedorPreview = document.getElementById('contenedor-preview');
        const galeriaPreview = document.getElementById('galeria-preview');

        inputFotos.addEventListener('change', function(event) {
          contenedorBase64.innerHTML = '';
          galeriaPreview.innerHTML = '';

          const archivos = event.target.files;

          if (archivos.length > 0) {
            contenedorPreview.style.display = 'block';

            Array.from(archivos).forEach((archivo) => {
              const reader = new FileReader();
              
              reader.onload = function(e) {
                const inputOculto = document.createElement('input');
                inputOculto.type = 'hidden';
                inputOculto.name = 'imagenes_base64[]';
                inputOculto.value = e.target.result;
                contenedorBase64.appendChild(inputOculto);

                const img = document.createElement('img');
                img.src = e.target.result;
                img.alt = archivo.name;
                img.style.width = '150px';
                img.style.height = '150px';
                img.style.objectFit = 'cover';
                img.style.borderRadius = '8px';
                img.style.boxShadow = '0 2px 5px rgba(0,0,0,0.1)';
                
                galeriaPreview.appendChild(img);
              };
              reader.readAsDataURL(archivo);
            });
          } else {
            contenedorPreview.style.display = 'none';
          }  
        });