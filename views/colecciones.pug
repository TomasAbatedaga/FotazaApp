extends layout

block metadata
  title Fotaza 2 - Colecciones

block contenido
  div(style="max-width: 800px; margin: 40px auto; padding: 20px;")
    h2(style="color: #8a5a44; text-align: center; margin-bottom: 30px;") Mis Colecciones Privadas

    div(style="background: #fdf5f5; padding: 20px; border-radius: 8px; margin-bottom: 40px; text-align: center;")
      h3(style="margin-top: 0; color: #333;") Crear Nueva Colección
      form(action="/colecciones/crear" method="POST" style="display: flex; gap: 10px; justify-content: center;")
        input(type="text" name="nombre" required placeholder='Ej: "Paisajes", "Inspiración"' style="padding: 10px; width: 300px; border-radius: 5px; border: 1px solid #ccc;")
        button(type="submit" style="background: #8a5a44; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; font-weight: bold;") Crear

    if colecciones && colecciones.length > 0
      div(style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px;")
        each col in colecciones
          a(href=`/colecciones/${col.id}` style="text-decoration: none; color: inherit; display: block;")
            div(style="background: white; border: 1px solid #eee; border-radius: 8px; padding: 20px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); text-align: center; transition: transform 0.2s;")
              h3(style="color: #8a5a44; margin: 0 0 10px 0;") 📁 #{col.nombre}
              p(style="color: #666; margin: 0;") 
                strong #{col.publicaciones_guardadas ? col.publicaciones_guardadas.length : 0} 
                | publicaciones guardadas
    else
      p(style="text-align: center; color: #999;") No creaste ninguna collecion.