extends layout

block metadata
  title Fotaza 2 - Perifl de #{usuarioObjetivo.nombre_usuario}

block estilos
  style.
    .galeria-contenedor { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; align-items: stretch; margin-top: 30px; }
    .tarjeta-foto { text-decoration: none; color: inherit; display: flex; flex-direction: column; background: #fff; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 8px rgba(0,0,0,0.05); transition: transform 0.2s ease, box-shadow 0.2s ease; height: 100%; }
    .tarjeta-foto:hover { transform: translateY(-5px); box-shadow: 0 8px 16px rgba(0,0,0,0.1); }
    .contenedor-imagen { height: 220px; width: 100%; border-bottom: 1px solid #f4eae6; }
    .contenedor-imagen img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .info-foto { padding: 15px; display: flex; flex-direction: column; flex-grow: 1; }
    .etiqueta-pill { display: inline-block; background-color: #8a5a44; color: white; padding: 4px 10px; border-radius: 15px; font-size: 0.8em; margin-right: 5px; margin-top: 8px; text-decoration: none; }

block contenido
  div(style="max-width: 1000px; margin: 40px auto; padding: 20px;")
    h2(style="color: #8a5a44; text-align: center;") Perfil de #{usuarioObjetivo.nombre_usuario}
    
    div(style="display: flex; justify-content: center; gap: 30px; margin: 20px 0; font-size: 1.1em; color: #555;")
      div
        strong #{cantSeguidores} 
        | Seguidores
      div
        strong #{cantSeguidos} 
        | Seguidos

    if usuario && usuario.id !== usuarioObjetivo.id
      form(action=`/usuario/${usuarioObjetivo.id}/seguir` method="POST" style="text-align: center; margin-bottom: 30px;")
        if loSigo
          button(type="submit" style="background: #ccc; color: #333; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; font-weight: bold;") Siguiendo (Dejar de seguir)
        else
          button(type="submit" style="background: #8a5a44; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; font-weight: bold;") Seguir
    else if !usuario
      p(style="text-align: center; color: #cc0000; font-size: 0.9em;") Inicia sesion para seguir a este usuario.

    if fotos && fotos.length > 0
      div.galeria-contenedor
        each foto in fotos
          a.tarjeta-foto(href=`/foto/${foto.id}`)
            div.contenedor-imagen
              if foto.imagenes && foto.imagenes.length > 0
                img(src=foto.imagenes[0].url_imagen alt=foto.titulo)
              else
                div(style="width: 100%; height: 100%; background: #eee; display: flex; align-items: center; justify-content: center; color: #999;") Sin imagen
            
            div.info-foto
              h4(style="margin: 0 0 5px 0; color: #333;")= foto.titulo
              p(style="margin: 0; color: #8a5a44; font-weight: bold; font-size: 0.9em;") #{usuarioObjetivo.nombre_usuario}
              
              if foto.descripcion
                p(style="margin: 8px 0 0 0; color: #666; font-size: 0.9em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;")= foto.descripcion
              else
                p(style="margin: 8px 0 0 0; color: #aaa; font-size: 0.9em; font-style: italic;") Sin descripcion

              if foto.etiquetas
                div(style="margin-top: auto; padding-top: 10px;")
                  each etiqueta in foto.etiquetas
                    span.etiqueta-pill(style="text-decoration: none;")= etiqueta.nombre
    else
      div(style="text-align: center; padding: 40px; background: #fff; border-radius: 8px; margin-top: 30px;")
        h3(style="color: #666;") Este usuario no tiene publicaciones