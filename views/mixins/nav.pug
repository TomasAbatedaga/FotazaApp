mixin nav(usuario)
  header.navbar
    a.navbar-logo(href="/") Fotaza 2
    div.navbar-menu
      if usuario
        span Hola, #{usuario.nombre_usuario}
        if usuario.rol === 'validador' || usuario.rol === 'admin'
          a.btn-oscuro(href="/validador/panel" style="background-color: #cc0000; border-color: #cc0000; margin-right: 10px;") Panel Validador
        a.btn-claro(href="/mi-perfil" style="margin-right: 10px;") Mi Perfil
        a.btn-claro(href="/nuevaFoto") Subir Foto
        a.btn-claro(href="/auth/logout") Cerrar Sesion
      else
        a.btn-claro(href="/auth/login") Iniciar Sesion
        a.btn-oscuro(href="/auth/registro") Crear Cuenta