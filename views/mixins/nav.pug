mixin nav(usuario)
  header.navbar
    a.navbar-logo(href="/") Fotaza 2
    form(action="/buscar" method="GET" style="display: flex; flex: 1; max-width: 400px; margin: 0 20px;")
      input(type="text" name="q" placeholder="Buscar perfiles o publicaciones..." required style="flex: 1; padding: 8px 15px; border: 1px solid #ccc; border-radius: 20px 0 0 20px; outline: none;")
      button(type="submit" style="background: #8a5a44; color: white; border: none; padding: 8px 15px; border-radius: 0 20px 20px 0; cursor: pointer;") Buscar
    div.navbar-menu
      if usuario
        a.btn-oscuro(href="/nuevaFoto") Subir Foto
        
        if usuario.rol === 'validador' || usuario.rol === 'admin'
          a.btn-oscuro(href="/validador/panel" style="background-color: #cc0000; border-color: #cc0000; margin-left: 10px;") Validador
        
        div.dropdown
          button.btn-usuario Hola, #{usuario.nombre_usuario} ▼
          div.dropdown-contenido
            a(href="/mi-perfil") Mi Perfil
            a(href="/feed") Mi Feed
            a(href="/mensajes") Mensajes
            a(href="/notificaciones") Notificaciones
            a(href="/colecciones") Favoritos
            a(href="/auth/logout" style="color: #cc0000; font-weight: bold;") Cerrar Sesión
      else
        a.btn-claro(href="/auth/login") Iniciar Sesion
        a.btn-oscuro(href="/auth/registro") Crear Cuenta